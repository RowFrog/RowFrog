#!/bin/bash
# RowFrog pre-push check for the Pi remote (set up 11 Nov 2026 while GitHub is down).
# Runs what .github/workflows/ci.yml runs, on exactly the commit being pushed, in a
# separate checkout: ruff, backend pytest with coverage, the Worker tests (Node),
# check_translations, check_web_parity, and, when ios/ or testdata/ changed, xcodegen + xcodebuild test
# in English. Also guards main: no deletes, no non-fast-forward, 86e1980 stays in it.
# A failure refuses the push. Logs: RowFrog/log/pre-push-<sha>.log (browser tests in full: log/browser-<sha>.txt).
# Load mode (scripts/local/loadmode.sh, 12 Nov 2026): in busy mode the commits are checked two at a time,
# each with its own checkout, DerivedData and iPhone Simulator; in quiet mode one at a time, at low
# priority (taskpolicy -b) and with xcodebuild -jobs at half the cores.
remote="$1"
[ "$remote" = pi ] || exit 0

export PATH="/opt/local/bin:/opt/local/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
top=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)") || exit 1  # the main checkout, also from a worktree
logdir="$top/log"; mkdir -p "$logdir"
passed="$logdir/checks-passed.txt"; touch "$passed"
zero=0000000000000000000000000000000000000000
keep=86e198013   # "Screenshots leave git history" (#66): must stay in main's history
venv="$top/backend/.venv"
lm="$top/scripts/local/loadmode.sh"; [ -x "$lm" ] || lm=""
prefix=""; jobs=""
if [ -n "$lm" ]; then prefix=$("$lm" prefix 2>/dev/null); jobs="-jobs $("$lm" jobs 2>/dev/null)"; fi

refuse() { echo "pre-push: $*" >&2; exit 1; }

checks() {  # $1 = commit, $2 = commit it is compared with for "did ios/ change", $3 = slot (0, 1, …)
  local sha=$1 base=$2 slot=${3:-0} log="$logdir/pre-push-${1:0:9}.log" ok=0
  local wt="${TMPDIR:-/tmp}/rowfrog-prepush" dd="$HOME/Library/Developer/Xcode/DerivedData/RowFrog-prepush"
  [ "$slot" != 0 ] && { wt="$wt-$slot"; dd="$dd-$slot"; }
  if grep -qx "$sha" "$passed"; then echo "pre-push: ${sha:0:9} already passed the checks"; return 0; fi
  echo "pre-push: checking ${sha:0:9} (log: $log)"
  git worktree remove --force "$wt" >/dev/null 2>&1; rm -rf "$wt"
  local try
  for try in 1 2 3; do  # two slots may add their checkouts at the same moment
    git worktree add --detach --force "$wt" "$sha" >/dev/null 2>&1 && break
    [ "$try" = 3 ] && { echo "pre-push: no checkout of $sha" >&2; return 1; }; sleep $((slot + 2))
  done
  {
    echo "== $(date '+%F %T') checks for $sha"
    echo "== ruff"
    (cd "$wt/backend" && "$venv/bin/python" -m ruff check . ../scripts) || ok=1
    echo "== backend pytest with coverage"
    (cd "$wt/backend" && PYTHONPATH="$wt/backend" "$venv/bin/python" -m pytest -q -p no:cacheprovider \
       --cov=rowfrog --cov-report=json:"$logdir/coverage-${sha:0:9}.json" 2>&1 | tail -15; exit "${PIPESTATUS[0]}") || ok=1
    echo "== translations"
    (cd "$wt" && "$venv/bin/python" scripts/check_translations.py) || ok=1
    echo "== app texts on the website"
    if [ -f "$wt/scripts/check_web_parity.py" ]; then
      (cd "$wt" && "$venv/bin/python" scripts/check_web_parity.py) || ok=1
    else
      echo "skipped: this commit has no scripts/check_web_parity.py yet"
    fi
    echo "== Cloudflare Workers"
    if command -v node >/dev/null; then
      (cd "$wt" && node --test cloudflare/tests/*.test.mjs 2>&1 | tail -15; exit "${PIPESTATUS[0]}") || ok=1
    else
      echo "WARNING: Node.js is not installed (sudo port install nodejs22), so the Worker tests were skipped"
    fi
    if [ "$base" = "$zero" ] || git diff --name-only "$base" "$sha" | grep -qE '^(web/|scripts/build_web\.py$|\.github/workflows/website\.yml$)'; then
      echo "== website (as website.yml): node tests + build"
      (cd "$wt" && node --test web/tests/*.test.mjs 2>&1 | tail -8; exit "${PIPESTATUS[0]}") || ok=1
      (cd "$wt" && "$venv/bin/python" scripts/build_web.py) || ok=1
      if [ -d "$top/node_modules/playwright" ]; then
        # One browser test run at a time, also when two commits are checked side by side: under the
        # load of two runs, timing tests flaked (12-13 Nov 2026). The lock is a directory (mkdir is atomic).
        lock="${TMPDIR:-/tmp}/rowfrog-browser-tests.lock"; until mkdir "$lock" 2>/dev/null; do find "$lock" -maxdepth 0 -mmin +20 -exec rmdir {} + 2>/dev/null; sleep 3; done  # a lock older than 20 min is stale
        (cd "$wt" && ln -s "$top/node_modules" node_modules && node --test web/tests/browser/*.test.mjs > "$logdir/browser-${sha:0:9}.txt" 2>&1; rc=$?
         grep -E "^not ok|^ +not ok" "$logdir/browser-${sha:0:9}.txt"; tail -8 "$logdir/browser-${sha:0:9}.txt"; exit $rc) || ok=1
        rmdir "$lock" 2>/dev/null
      else
        echo "WARNING: no npm packages (npm ci), so the website's browser tests were skipped"
      fi
    else
      echo "== website: nothing under web/ changed, skipped"
    fi
    if [ "$base" = "$zero" ] || git diff --name-only "$base" "$sha" | grep -qE '^(ios/|testdata/|\.github/workflows/ci\.yml$|scripts/newest_xcode_runner\.py$)'; then
      echo "== iOS: xcodegen + xcodebuild test (English)"
      device=$(xcrun simctl list devices available -j | python3 -c '
import json, sys
runtimes = sorted((r for r in json.load(sys.stdin)["devices"].items() if "iOS-" in r[0]),
                  key=lambda r: [int(n) for n in r[0].rsplit("iOS-", 1)[-1].split("-") if n.isdigit()])
phones = [(r, d) for r, ds in runtimes for d in ds if d["name"].startswith("iPhone") and "Duo" not in d["name"]]
newest = [d for r, d in phones if r == phones[-1][0]] if phones else []
# Slot 0: the iPhone Pro of the newest runtime (as before); slot 1: its Pro Max, then the others.
rank = lambda d: (0 if d["name"].endswith(" Pro") else 1 if d["name"].endswith(" Pro Max") else 2, d["name"])
found = [d["udid"] for d in sorted(newest, key=rank)]
slot = int(sys.argv[1]); print(found[slot] if len(found) > slot else (found[0] if found else ""))' "$slot")
      echo "Xcode: $(xcodebuild -version | head -1), device $device, slot $slot${prefix:+, low priority}"
      (cd "$wt/ios" && xcodegen >/dev/null && $prefix xcodebuild test $jobs -project RowFrog.xcodeproj -scheme RowFrog \
         -destination "id=$device" -derivedDataPath "$dd" -testLanguage en -testRegion US 2>&1 \
         | grep -E "Executed|error:|failed \(|TEST (SUCCEEDED|FAILED)" | tail -15; exit "${PIPESTATUS[0]}") || ok=1
    else
      echo "== iOS: nothing under ios/ or testdata/ changed, skipped (as CI does)"
    fi
    echo "== result: $([ $ok = 0 ] && echo passed || echo FAILED)"
  } </dev/null > "$log" 2>&1
  git worktree remove --force "$wt" >/dev/null 2>&1
  grep -E "^== (ruff|backend|translations|Cloudflare|iOS|result)|passed in|failed|Executed .* tests|WARNING|error:" "$log" | tail -20
  [ $ok = 0 ] && echo "$sha" >> "$passed"
  return $ok
}

refs=()
while read -r lref lsha rref rsha; do refs+=("$lref $lsha $rref $rsha"); done
status=0
todo=()
for line in "${refs[@]}"; do
  read -r lref lsha rref rsha <<<"$line"
  if [ "$rref" = refs/heads/main ]; then
    [ "$lsha" = "$zero" ] && refuse "main is never deleted"
    if [ "$rsha" != "$zero" ] && ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
      refuse "main only grows: ${lsha:0:9} does not contain the Pi's main ${rsha:0:9} (no force push, no rebase)"
    fi
    git merge-base --is-ancestor "$keep" "$lsha" 2>/dev/null || refuse "86e1980 must stay in main's history"
  fi
  [ "$lsha" = "$zero" ] && continue                       # deleting a branch: nothing to test
  case "$rref" in refs/heads/model-check) continue ;; refs/heads/*) ;; *) continue ;; esac  # data branch, screenshots refs
  base=$rsha
  [ "$base" = "$zero" ] && base=$(git merge-base "$lsha" refs/remotes/pi/main 2>/dev/null || echo "$zero")
  todo+=("$lsha $base")
done
n=1; [ -n "$lm" ] && n=$("$lm" sims checks 2>/dev/null || echo 1)
[ -n "$lm" ] && echo "pre-push: load mode $("$lm" mode 2>&1 | tr '\n' ' ')- $n at a time"
i=0
while [ $i -lt ${#todo[@]} ]; do
  pids=(); outs=()
  for slot in $(seq 0 $((n - 1))); do
    [ $((i + slot)) -lt ${#todo[@]} ] || break
    read -r sha base <<<"${todo[$((i + slot))]}"
    out=$(mktemp); outs+=("$out")
    if [ "$n" = 1 ]; then checks "$sha" "$base" 0 > "$out" 2>&1; echo $? >> "$out.rc"; else (checks "$sha" "$base" "$slot"; echo $? > "$out.rc") > "$out" 2>&1 & pids+=($!); fi
  done
  [ ${#pids[@]} -gt 0 ] && wait "${pids[@]}"
  for out in "${outs[@]}"; do cat "$out"; [ "$(tail -1 "$out.rc" 2>/dev/null)" = 0 ] || status=1; rm -f "$out" "$out.rc"; done
  i=$((i + n))
done
[ $status = 0 ] || echo "pre-push: checks failed, nothing was pushed (see RowFrog/log/)" >&2
exit $status
