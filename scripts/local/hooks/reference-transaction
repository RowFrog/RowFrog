#!/bin/bash
# Refreshes inbox/main.bundle once a push (or fetch) has moved refs/remotes/pi/main,
# i.e. after a green push to the Pi (12 Nov 2026). Never fails the git command.
[ "$1" = committed ] || exit 0
grep -q ' refs/remotes/pi/main$' || exit 0
"$(git rev-parse --path-format=absolute --git-common-dir)/hooks/write-main-bundle" >/dev/null 2>&1 &
exit 0
