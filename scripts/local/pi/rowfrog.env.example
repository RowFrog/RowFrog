# Settings for the Pi's jobs (rowfrog-publish, model check, budget check), read by
# their services as EnvironmentFile. Copy to /home/rowfrog/.config/rowfrog.env, fill in,
# then: chmod 600 /home/rowfrog/.config/rowfrog.env   (the real file never goes into git)
# Copernicus account (satellite pictures and ice). Leave empty to skip them.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Copernicus login (email and password, password in single quotes): the ice
# map download refuses the client key since Nov 2026.
CDSE_USERNAME=
CDSE_PASSWORD=
# Cloudflare account and an API token (usage counter reads, budget check).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# The usage counter key (Worker secret USAGE_KEY of rowfrog-usage). Optional:
# without it the confirmed clubs count as used.
RW_USAGE_KEY=
# Which branch of the Pi's repository to run (empty = main).
BRANCH=
# Schneeregen (backend/rowfrog/sleet.py, decision 0042): off switches it off;
# the cold band in which clubs are asked for rain and snowfall (default -2 to 4 °C).
# RW_SLEET=off
# RW_SLEET_MIN_C=-2
# RW_SLEET_MAX_C=4
