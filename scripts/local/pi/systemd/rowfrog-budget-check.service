# Usage limits (budget-check.yml): calls against the free limits, daily. Started by rowfrog-budget-check.timer; by hand: sudo systemctl start rowfrog-budget-check
# Logs: journalctl -u rowfrog-budget-check -e; reports in ~/reports/.
[Unit]
Description=Row Frog Usage limits (budget-check.yml): calls against the free limits, daily
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=rowfrog
Group=rowfrog
EnvironmentFile=/home/rowfrog/.config/rowfrog.env
ExecStart=/home/rowfrog/rowfrog-pi/run.sh budget-check
TimeoutStartSec=60min
Nice=10
IOSchedulingClass=idle
