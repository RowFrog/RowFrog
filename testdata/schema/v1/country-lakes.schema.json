{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "/v1/countries/{code}/lakes",
  "description": "One country's lakes and rivers with their clubs; the same shape as lakes/index.",
  "x-sample": "countries/de/lakes",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "center": {
        "type": "object",
